# Cost Guard Environment Configuration

# Server
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-super-secret-key-in-production

# Database (PostgreSQL + pgvector)
POSTGRES_USER=costguard
POSTGRES_PASSWORD=costguard_secret
POSTGRES_DB=costguard_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://costguard:costguard_secret@localhost:5432/costguard_db
DATABASE_SYNC_URL=postgresql+psycopg2://costguard:costguard_secret@localhost:5432/costguard_db

# LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

